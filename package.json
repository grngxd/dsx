{
  "name": "dsxjs",
  "description": "a lightweight library for building reactive with discord.js & bun (or node)",
  "version": "0.2.2",
  "author": "grng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/grngxd/dsx"
  },
  "type": "module",
  "main": "out/index.js",
  "types": "out/index.d.ts",
  "files": [
    "out",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./out/index.js",
    "./components": "./out/components/index.js",
    "./renderer": "./out/renderer/index.js",
    "./hooks": "./out/hooks/index.js",
    "./jsx-runtime": "./out/jsx-runtime/index.js",
    "./types": "./out/types.js"
  },
  "keywords": [
    "discord.js",
    "discord",
    "framework",
    "reactive"
  ],
  "homepage": "https://github.com/grngxd/dsx",
  "bugs": {
    "url": "https://github.com/grngxd/dsx/issues"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "bunx rimraf out",
    "build": "bunx tsc --project tsconfig.build.json",
    "pack:check": "bunx npm pack --dry-run",
    "prepack": "bun run clean && bun run build",
    "prepublishOnly": "bun run build && bun run pack:check",
    "release:patch": "bunx npm version patch && bun publish",
    "release:minor": "bunx npm version minor && bun publish",
    "release:major": "bunx npm version major && bun publish"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5",
    "discord.js": "^14.21.0"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  }
}
