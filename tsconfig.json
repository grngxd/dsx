{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "jsx-runtime",
    "paths": {"*": ["./*"]},
    "rootDir": ".",
    "outDir": "out",
    "declaration": true,
    "allowJs": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": false,
    "noEmit": false,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "index.ts",
    "types.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "renderer/**/*.ts",
    "renderer/**/*.tsx",
    "jsx-runtime/**/*.ts",
    "jsx-runtime/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "**/*.test.ts",
    "**/*.test.tsx",
    "index.test.tsx",
    "bun.lockb",
    "bunfig.toml",
    "bun.lock",
    "bun.lock.json",
    "**/*.js"
  ]
}
